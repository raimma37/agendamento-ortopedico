# Banco de dados PostgreSQL 100% local
# Desenvolvimento local (host): localhost:5432
# Produção via Docker Compose: db:5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=agendamento_db
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agendamento_db?schema=public"

# Autenticação Admin (JWT) - altere em produção (mínimo 16 caracteres)
JWT_SECRET="altere-esta-chave-secreta-em-producao"

# Chave opcional dedicada para criptografia de secrets de webhook (AES-256-GCM)
# Se vazia, deriva da JWT_SECRET
WEBHOOK_ENCRYPTION_KEY=""

# Defina como "true" atrás de proxy reverso confiável (Nginx/Traefik/Cloudflare)
TRUST_PROXY="false"

# URL pública do sistema
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Credenciais iniciais do seed
ADMIN_EMAIL="admin@clinica.com.br"
ADMIN_PASSWORD="admin123"
ADMIN_NAME="Administrador"
